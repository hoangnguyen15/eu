APP_ENV=local

# Compose derives DATABASE_URL from DB_PASSWORD; this value is for running the API/tests on the host.
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://imageapp:CHANGE_ME@localhost:5432/image_platform
REDIS_URL=redis://redis:6379/0

JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

IMAGE_PROVIDER=mock
# Must stay false until Milestone 0 (legal/ToS/ownership) is signed off. Refused in production.
FLOW_BROWSER_ENABLED=false

S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=generated-images
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
