# Copy to .env and replace every CHANGE_ME value (e.g. `openssl rand -hex 32`).
# Never commit .env.

# --- core ---------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
POSTGRES_USER=flow
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=flow
REDIS_PASSWORD=CHANGE_ME_redis_password
JWT_SECRET=CHANGE_ME_at_least_32_random_characters_long
GATEWAY_SHARED_SECRET=CHANGE_ME_at_least_24_random_characters
# Bootstrap admin (used by scripts/bootstrap.sh)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- network ------------------------------------------------------------
# Address of THIS server as seen by phones and Windows workstations (LAN IP or
# DNS name, e.g. 192.168.1.10). Used for signed image URLs, the gateway TLS
# certificate and agent provisioning files. scripts/init-env.sh detects it.
PUBLIC_HOST=localhost
# Demo agent container networking: host (Linux, PUBLIC_HOST=localhost) or bridge (macOS / LAN IP)
AGENT_NETWORK_MODE=host
API_PORT=8000
GATEWAY_PORT=8443
MINIO_PORT=9000
CORS_ALLOW_ORIGINS=
TRUSTED_PROXY_COUNT=0
MAX_REQUEST_BYTES=1048576

# --- object storage (MinIO locally; Cloudflare R2 / S3 in production) -----
MINIO_ROOT_USER=flowminio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
S3_BUCKET=flow-assets
# Endpoint embedded in signed URLs: must be reachable by workers and mobile apps.
# Defaults to http://${PUBLIC_HOST}:9000 (bundled MinIO). For Cloudflare R2 set both:
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=us-east-1
S3_CREATE_BUCKET=true

# --- generation / credits ---------------------------------------------------
ENABLED_PROVIDERS=mock
DEFAULT_PROVIDER=mock
SIGNUP_BONUS_CREDITS=10
CREDIT_COST_PER_IMAGE=1
MAX_IMAGES_PER_GENERATION=4

# --- scheduler ----------------------------------------------------------------
OFFER_TTL_SECONDS=15
JOB_TIMEOUT_SECONDS=600
WORKER_OFFLINE_AFTER_SECONDS=90
HEARTBEAT_INTERVAL_SECONDS=25
MAX_DISPATCH_ATTEMPTS=5
MAX_CONCURRENT_JOBS_PER_ACCOUNT=2

# Google Flow connector stays disabled; both must be true AND an approved
# implementation must exist before it can be used.
GOOGLE_FLOW_ENABLED=false
GOOGLE_FLOW_INTEGRATION_CONFIRMED=false
