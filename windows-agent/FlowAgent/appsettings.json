{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Agent": {
    "ServerBaseUrl": "https://flow-gateway.example.com:8443",
    "WebSocketPath": "/ws/v1/agent",
    "CaCertificatePath": "C:\\ProgramData\\FlowAgent\\ca.crt",
    "DataDirectory": "C:\\ProgramData\\FlowAgent",
    "EnrollmentToken": "",
    "Capacity": 2,
    "HeartbeatSeconds": 25,
    "SessionReportMinutes": 5,
    "AcceptTimeoutSeconds": 10,
    "Providers": [ "mock" ],
    "Accounts": [
      { "GoogleEmail": "mock-account@example.com", "ProfileRef": "profile-1", "Provider": "mock" }
    ],
    "Mock": { "LatencyMilliseconds": 800 },
    "Approved": { "BaseUrl": "", "ApiKeyEnvironmentVariable": "FLOWAGENT_APPROVED_API_KEY" },
    "GoogleFlow": { "Enabled": false }
  }
}
