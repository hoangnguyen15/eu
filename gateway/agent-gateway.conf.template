# mTLS gateway for Windows worker agents (rendered by the nginx image's envsubst;
# only ${GATEWAY_SHARED_SECRET} and ${BACKEND_UPSTREAM} are substituted).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8443 ssl;
    server_name _;

    ssl_certificate        /certs/server.crt;
    ssl_certificate_key    /certs/server.key;
    ssl_client_certificate /certs/ca.crt;   # only certificates issued by the platform CA
    ssl_verify_client      optional;        # enrollment happens before a client cert exists
    ssl_verify_depth       2;
    ssl_protocols          TLSv1.2 TLSv1.3;
    ssl_session_cache      shared:agent:10m;

    client_max_body_size 64k;
    server_tokens off;

    # First contact: single-use enrollment token + CSR -> client certificate.
    location = /api/v1/agent/enroll {
        limit_except POST { deny all; }
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Client-Verify "";
        proxy_set_header X-Client-Cert "";
        proxy_set_header X-Gateway-Secret "";
    }

    # Agent channel: requires a verified client certificate.
    location = /ws/v1/agent {
        if ($ssl_client_verify != SUCCESS) { return 403; }
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Client-Verify $ssl_client_verify;
        proxy_set_header X-Client-Cert $ssl_client_escaped_cert;
        proxy_set_header X-Gateway-Secret "${GATEWAY_SHARED_SECRET}";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / { return 404; }
}
